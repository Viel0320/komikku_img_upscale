* text=auto
* text eol=lf

# Windows forced line-endings
/.idea/* text eol=crlf

# Gradle wrapper
*.jar binary

# Native static libraries - CRLF normalization corrupts ar archives
*.a binary

# ML model weights, QNN contexts and native libraries - CRLF normalization
# shifts bytes and silently corrupts model inference (black-screen output)
*.bin binary
*.so binary
*.dlc binary

# Images
*.webp binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.eot binary
*.woff binary
*.pyc binary
*.swp binary
